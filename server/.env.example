# ContractIQ Server Configuration

# JWT Secret Key (change this in production!)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ========================================
# SMTP Email Configuration
# ========================================
# For sending OTP codes during password reset
# Leave SMTP_USER and SMTP_PASSWORD empty to use console logging (development mode)

# --- Gmail Configuration (for testing) ---
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=ContractIQ

# --- SendGrid Configuration (recommended for production) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SENDER_EMAIL=verified-email@yourdomain.com
# SENDER_NAME=ContractIQ

# --- Mailgun Configuration ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-mailgun-domain.com
# SMTP_PASSWORD=your-mailgun-password
# SENDER_EMAIL=noreply@your-mailgun-domain.com
# SENDER_NAME=ContractIQ

# --- AWS SES Configuration ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password
# SENDER_EMAIL=verified@yourdomain.com
# SENDER_NAME=ContractIQ

# See EMAIL_SETUP_GUIDE.md for detailed instructions
