# Copy this file to server/.env and replace every placeholder locally.
# Never commit server/.env or any real credentials.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/contractiq
TOKEN_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=28800

# Optional AI integrations. Leave blank to use ContractIQ's local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
GROQ_API_KEY=
